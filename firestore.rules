rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /agents/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid && valid(request.resource.data);
    }
    function valid(d) {
      return d.keys().hasOnly(['name','look','personality','ownerName','lat','lon','approx','preciseVisibility','updatedAt'])
        && d.keys().hasAll(['name','look','lat','lon','preciseVisibility','updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 40
        && d.look is map && d.look.keys().hasOnly(['color','emoji']) && d.look.color is string && d.look.color.size() <= 9 && d.look.emoji is string && d.look.emoji.size() <= 16
        && (!('personality' in d) || (d.personality is string && d.personality.size() <= 300))
        && (!('ownerName' in d) || (d.ownerName is string && d.ownerName.size() <= 80))
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lon is number && d.lon >= -180 && d.lon <= 180
        && (!('approx' in d) || (d.approx is map && d.approx.lat is number && d.approx.lon is number))
        && d.preciseVisibility == 'private'
        && d.updatedAt == request.time;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
